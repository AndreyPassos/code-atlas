# Optional. Public GitHub/GitLab REST APIs work fully unauthenticated for public
# resources — these tokens only raise the rate limit (GitHub: 60 req/hour anonymous
# vs 5000 authenticated; GitLab applies per-IP limits to anonymous requests).
# Copy this file to .env and fill in values if you have them. Never commit .env.
#
# Prefixed with EXPO_PUBLIC_ so Expo inlines them into the client bundle at build
# time (https://docs.expo.dev/guides/environment-variables/). These are read-only,
# rate-limit-raising tokens with no write scope requested — safe for a client bundle,
# unlike a secret that grants write/delete access.

# GitHub personal access token (no scopes needed for public repo/issue reads).
# Create one at https://github.com/settings/tokens
EXPO_PUBLIC_GITHUB_TOKEN=

# GitLab personal access token (no scopes needed for public project/issue reads).
# Create one at https://gitlab.com/-/user_settings/personal_access_tokens
EXPO_PUBLIC_GITLAB_TOKEN=
